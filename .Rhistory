#| echo: false
#| message: false
import plotly.graph_objects as go
# Данни за седмиците
weeks = list(range(1, 31))
# Дефиниране на детайлите за всеки сет
datasets = [
{"label": "Desktop, Travel Micro-moments", "color": "#DC143C", "dash": "solid", "visible": True, "data": [0, 60, 33.33, 15.79, 35.29, 46.15, 50, 30.77, 21.43, 15.38, 15.79, 42.86, 0, 38.46, 50, 60, 20, 10, 11.54, 50, 25, 31.58, 0, 20, 0, 0, 100, 33.33, 0, 0]},
{"label": "Desktop, Travel Pageviews", "color": "#1E90FF", "dash": "solid", "visible": True, "data": [0, 29.49, 16.48, 1.48, 28.32, 27.04, 6.63, 5.16, 6.23, 2.82, 2.07, 39.87, 0, 8.91, 8.97, 12.22, 10.69, 4.81, 1.78, 12.23, 33.27, 3.67, 0, 25.92, 0, 0, 20.25, 27.98, 0, 0]},
{"label": "Desktop, Travel Time", "color": "#228B22", "dash": "solid", "visible": True, "data": [0, 33.83, 15.88, .73, 23.78, 22.37, 8.39, 4.92, 5.76, 2.63, 2.99, 52.71, 0, 7.68, 9.65, 9.13, 11.04, 4.91, 2.96, 9.6, 39.14, 4.89, 0, 22.86, 0, 0, 22.72, 45.57, 0, 0]},
{"label": "Desktop, Travel Domains", "color": "#FFD700", "dash": "solid", "visible": True, "data": [0, 35.12, 15.77, 4.2, 22.37, 16, 11.59, 8.23, 5.85, 2.49, 2.39, 13, 0, 10.79, 7.64, 12.28, 9.43, 4.69, 1.86, 14.52, 12.14, 6.72, 0, 16.18, 0, 0, 30.19, 12.5, 0, 0]},
{"label": "Mobile, Travel Micro-moments", "color": "#00BFFF", "dash": "dash", "visible": "legendonly", "data": [28.57, 25.71, 14.39, 11.54, 20.39, 23.81, 17.82, 8.63, 10.26, 20.49, 12.28, 5.93, 22.34, 16, 24.3, 21.43, 18.4, 28.04, 13.71, 16.39, 16.51, 22.54, 3.23, 22.14, 27.71, 29.5, 36.73, 16.39, 13.89, 0]},
{"label": "Mobile, Travel Pageviews", "color": "#D2691E", "dash": "dash", "visible": "legendonly", "data": [4.91, 9.85, 14.57, 1.87, 9.63, 5.31, 5.88, 3.94, 3.44, 5.15, 2.41, 1.83, 6, 5, 4.79, 4.83, 8.82, 9.52, 2.95, 6.34, 6.4, 5.81, .71, 4.57, 3.87, 13.07, 21.41, 4.58, 3.52, 0]},
{"label": "Mobile, Travel Time", "color": "#BA55D3", "dash": "dash", "visible": "legendonly", "data": [1.39, 6.77, 6.82, 1.4, 5.89, 4.01, 2.77, 3.89, 1.14, 2.75, 1.88, .79, 7.45, 1.64, 5.06, 5.58, 7.92, 9.89, 2.24, 3.56, 4.7, 5.52, .23, 2.17, 2.87, 7.32, 20.07, 3.55, 2.92, 0]},
{"label": "Mobile, Travel Domains & Apps", "color": "#FF6347", "dash": "dash", "visible": "legendonly", "data": [3.12, 7.73, 8.65, 3.12, 5.56, 4.33, 3.6, 2.06, 3.42, 5.92, 3.25, 2.01, 6.1, 3.61, 5.95, 4.38, 6.2, 8.19, 2.88, 3.26, 4.88, 4.7, .87, 6.24, 5.11, 12.32, 12.49, 5.72, 3.9, 0]}
]
fig = go.Figure()
for ds in datasets:
fig.add_trace(go.Scatter(
x=weeks,
y=ds["data"],
mode='lines+markers',
name=ds["label"],
visible=ds["visible"],
line=dict(color=ds["color"], width=2, dash=ds["dash"]),
marker=dict(size=4)
))
fig.update_layout(
xaxis_title="Week",
yaxis_title="Percentage of travel-related activity (%)",
legend=dict(orientation="h", yanchor="bottom", y=-0.5, xanchor="center", x=0.5),
hovermode="x unified",
margin=dict(l=40, r=40, t=20, b=100),
template="plotly_white"
)
fig.show()
